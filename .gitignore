# --- ERP Vendas (Delphi) — T07 (GUARDRAILS regra 16: nenhum segredo/licenca no repo) ---

# Config real (segredos: conexao, URL do Financeiro, SMTP, ApiKey) — só o
# .example fica versionado (T09 cria config/erpvendas.ini.example)
erpvendas.ini
config/*.ini
!config/erpvendas.ini.example

